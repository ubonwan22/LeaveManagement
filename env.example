# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า:  cp .env.example .env
# (DB_USER ห้ามใช้ root เพราะ MySQL image ไม่อนุญาต)
DB_NAME=leave_db
DB_USER=leave_user
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=1
# ใส่ IP ของเครื่อง server เพื่อให้เครื่องอื่นในวง LAN เข้าได้ เช่น localhost,127.0.0.1,192.168.1.50  (หรือ * ตอนเดโม)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*

# สร้าง user ตอนเริ่มระบบครั้งแรก (เว้นว่างถ้าไม่ต้องการ)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin1234
DJANGO_SUPERUSER_EMAIL=admin@example.com

# 1 = ใส่พนักงานจำลองให้ถ้าฐานข้อมูลยังว่าง
SEED_DATA=1
